<% layout("/layouts/boilerplate") %>

<!-- ================= TITLE ================= -->
<div class="row mt-3">
  <div class="col-12">
    <h3><%= listing.title %></h3>
  </div>
</div>

<!-- ================= LISTING CARD ================= -->
<div class="row">
  <div class="col-md-6 offset-md-3">
    <div class="card show-card listing-card">

      <!-- SAFE IMAGE -->
      <img
        src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1505691938895-1758d7feb511' %>"
        class="card-img-top show-img"
      >

      <div class="card-body">

        <!-- OWNER SAFE -->
        <p class="card-text">
          <% if (listing.owner) { %>
            Owned by <i><%= listing.owner.username %></i>
          <% } else { %>
            Owned by <i>Unknown</i>
          <% } %>
        </p>

        <p class="card-text"><%= listing.description %></p>

        <p class="card-text">
          &#8377; <%= listing.price.toLocaleString("en-IN") %>
        </p>

        <p class="card-text"><%= listing.location %></p>
        <p class="card-text"><%= listing.country %></p>

      </div>
    </div>
  </div>
</div>

<br/>

<!-- ================= EDIT / DELETE ================= -->
<% if (currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>

  <div class="btns">
    <div class="col-md-6 offset-md-3 d-flex gap-3">

      <a href="/listings/<%= listing._id %>/edit" class="btn btn-danger">
        Edit
      </a>

      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
        <button class="btn btn-dark">Delete</button>
      </form>

    </div>
  </div>

<% } %>

<!-- ================= REVIEW SECTION ================= -->
<hr/>

<div class="col-md-8 offset-2 mb-3">

  <h4>Leave a review</h4>

  <% if (currUser) { %>

    <form action="/listings/<%= listing._id %>/reviews" method="POST">

      <!-- Rating -->
      <div class="mb-3 mt-3">
        <label class="form-label">Rating</label>

        <fieldset class="starability-slot">
          <input type="radio" name="review[rating]" value="1" checked />
          <input type="radio" name="review[rating]" value="2" />
          <input type="radio" name="review[rating]" value="3" />
          <input type="radio" name="review[rating]" value="4" />
          <input type="radio" name="review[rating]" value="5" />
        </fieldset>
      </div>

      <!-- Comment -->
      <div class="mb-3">
        <label class="form-label">Comment</label>
        <textarea name="review[comment]" class="form-control" required></textarea>
      </div>

      <button class="btn btn-outline-dark">Submit</button>
    </form>

    <hr/>

  <% } %>

  <!-- SHOW ALL REVIEWS -->
  <% if (listing.reviews && listing.reviews.length > 0) { %>

    <div class="row">
      <p><b>All Reviews</b></p>

      <% for (let review of listing.reviews) { %>

        <div class="col-md-5 ms-3 mb-3">

          <div class="card">
            <div class="card-body">

              <h5>
                <%= review.author?.username || "Anonymous" %>
              </h5>

              <p>Rating: <%= review.rating %></p>

              <p>
                <%= review.comment %>
              </p>

              <% if (currUser && review.author && review.author._id.equals(currUser._id)) { %>

                <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                  <button class="btn btn-sm btn-dark">Delete</button>
                </form>

              <% } %>

            </div>
          </div>

        </div>

      <% } %>

    </div>

  <% } %>

</div>

<!-- ================= MAP SECTION ================= -->
<div class="col-8 offset-2 mb-3">
  <h3>Where you'll be</h3>
  <div id="map"></div>
</div>

<style>
  #map {
    height: 400px;
    width: 100%;
    border-radius: 12px;
  }
</style>

<!-- ================= PASS DATA ================= -->
<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;
  const title = "<%= listing.title %>";
</script>

<script src="/js/map.js"></script>