<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
  <div class="col-12">
    <h3><%= listing.title %></h3>
  </div>
</div>

<div class="row">
  <div class="col-md-6 offset-md-3">
    <div class="card show-card listing-card">

      <img
        src="<%= listing.image.url || '/images/default.jpg' %>"
        class="card-img-top show-img"
      >

      <div class="card-body">

        <!-- ✅ OWNER SAFE -->
        <p class="card-text">
          <% if (listing.owner) { %>
            Owned by <i><%= listing.owner.username %></i>
          <% } else { %>
            Owned by <i>Unknown</i>
          <% } %>
        </p>

        <p class="card-text"><%= listing.description %></p>

        <p class="card-text">
          &#8377; <%= listing.price.toLocaleString("en-IN") %>
        </p>

        <p class="card-text"><%= listing.location %></p>
        <p class="card-text"><%= listing.country %></p>

      </div>
    </div>
  </div>
</div>

<br/>

<!-- ✅ SAFE EDIT/DELETE -->
<% if (currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>

  <div class="btns">
    <div class="col-md-6 offset-md-3 d-flex gap-3">

      <a href="/listings/<%= listing._id %>/edit" class="btn btn-danger">
        Edit
      </a>

      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
        <button class="btn btn-dark">Delete</button>
      </form>

    </div>
  </div>

<% } %>